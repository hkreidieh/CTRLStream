{
  "schemaVersion": 1,
  "checkedOn": "2026-10-11",
  "about": "Ingest rules per streaming platform for CTRLStream (CTRLStream for OBS Studio). Read by the platforms and setup skills and by the server's diagnose (BITRATE_ABOVE_PLATFORM_CAP). Every figure is {value, confidence, sources[, note]}; source ids resolve in 'sources'. A value of null means the platform does not publish one.",
  "confidenceLevels": {
    "high": "Read directly on the checked date from the platform's own documentation, the vendor's own documentation, or the OBS Studio source at the tag named in the source.",
    "medium": "From the platform's own documentation, but the page would not render for us (it redirected to a login) so the figure was read from a search-engine extract of that page. Re-check by opening the page.",
    "low": "Not confirmed from the platform's or vendor's own documentation: a dated or regional first-party page, a community source, or an inference. Treat as a starting point and say so to the user."
  },
  "rules": {
    "uploadHeadroomFraction": 0.7,
    "uploadRule": "Video bitrate plus audio bitrate must stay at or under 70% of the measured sustained upload (network_test), and the video bitrate must stay at or under platforms.<id>.video.maxBitrateKbps.value when that value is not null.",
    "noMeasurementFallback": {
      "resolution": "1280x720",
      "fps": 30,
      "videoBitrateKbps": 3000,
      "reason": "Twitch's own 720p30 figure; needs about 4.5 Mbps of upload with headroom."
    },
    "capLookup": "Find the platform whose obs.match fits the profile's stream service: for rtmp_common compare the service name with match.serviceNames; for rtmp_custom test the server URL against match.serverUrlPatterns (case-insensitive regular expressions). The cap is video.maxBitrateKbps.value."
  },
  "sources": {
